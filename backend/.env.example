# ==== Server ====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==== Database (MySQL) ====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthcare_appointments
DB_USER=root
DB_PASSWORD=changeme

# ==== Auth ====
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ==== LLM summaries (Groq - OpenAI-compatible API, free tier) ====
# Get a free key at https://console.groq.com
# Note: llmService.js sets baseURL to https://api.groq.com/openai/v1,
# so this key must be a Groq key (starts with gsk_), not an OpenAI key.
OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=openai/gpt-oss-20b

# ==== Email (Resend - HTTP API, works reliably on hosts that block SMTP ports) ====
# Get a free key at https://resend.com
# Without a verified custom domain, Resend only delivers to the address you
# signed up with. Verify a domain in the Resend dashboard to send to anyone.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Clinic Appointments <onboarding@resend.dev>

# ==== Google Calendar (OAuth 2.0) ====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# ==== Slot Hold ====
SLOT_HOLD_MINUTES=5