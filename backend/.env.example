# ==== Server ====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==== Database (MySQL) ====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthcare_appointments
DB_USER=root
DB_PASSWORD=changeme

# ==== Auth ====
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ==== OpenAI (LLM summaries) ====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ==== Email (Nodemailer - works with Gmail, Mailtrap, SendGrid SMTP, etc.) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Clinic Appointments <no-reply@clinic.com>"

# ==== Google Calendar (OAuth 2.0) ====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# ==== Slot Hold ====
SLOT_HOLD_MINUTES=5
